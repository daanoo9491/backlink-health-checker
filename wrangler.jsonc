{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The one live Worker. Serves the React app (static assets) and the /api/* backend.
  // It keeps the name "…-staging" so its address, secrets and data stay exactly
  // as they are: https://backlink-health-checker-staging.<subdomain>.workers.dev
  // (The separate production Worker was retired in 0.14.0.)
  "name": "backlink-health-checker-staging",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // Unknown paths fall back to index.html so client-side routes work.
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker first, never to static files.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "LinkLedger SEO",
  },

  // Database: Supabase Postgres (the "bhc-staging" project), reached through
  // Cloudflare Hyperdrive (connection pooling close to the Worker). See README → Database setup.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "28e1151b1a4349499e7eac877c4760d5",
      // Used only by `npm run dev` on your computer.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],

  // Background checking. One message = one batch of up to 8 links; batch size
  // 1 keeps each run inside the free plan's 50 outgoing requests.
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "bhc-checks-staging" }],
    "consumers": [{ "queue": "bhc-checks-staging", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3 }],
  },

  // Every 10 minutes: restart any scan whose background checking stalled,
  // and a tiny database write so Supabase's free plan never pauses the project.
  "triggers": { "crons": ["*/10 * * * *"] },
}
