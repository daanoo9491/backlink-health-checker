{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker. Serves the React app (static assets) and the /api/* backend.
  "name": "backlink-health-checker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // Unknown paths fall back to index.html so client-side routes work.
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker first, never to static files.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "Backlink Health Checker",
  },

  // Database: Supabase Postgres, reached through Cloudflare Hyperdrive
  // (connection pooling close to the Worker). Create it once with:
  //   npx wrangler hyperdrive create bhc-production --connection-string="<Supabase Session pooler string>"
  // then paste the printed id below. See README → Database setup.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "PASTE-PRODUCTION-HYPERDRIVE-ID-HERE",
      // Used only by `npm run dev` on your computer.
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
    },
  ],

  // Once a day: a tiny database write so Supabase's free plan never pauses
  // the project for inactivity, plus housekeeping of old sign-in counters.
  "triggers": { "crons": ["17 3 * * *"] },

  // Bindings added in later phases (kept here so the plan is visible):
  //   Phase 5  -> "queues"        (SCAN_QUEUE)
  //   Phase 8  -> "r2_buckets"    (EXPORTS) if exports get large
  //   Phase 11 -> more cron schedules (scheduled scans)

  "env": {
    "staging": {
      "name": "backlink-health-checker-staging",
      // Staging has its own Supabase project, so test data never touches production:
      //   npx wrangler hyperdrive create bhc-staging --connection-string="<staging Session pooler string>"
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "PASTE-STAGING-HYPERDRIVE-ID-HERE",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/postgres",
        },
      ],
      "triggers": { "crons": ["23 3 * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "APP_NAME": "Backlink Health Checker (Staging)",
      },
    },
  },
}
