{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production Worker. Serves the React app (static assets) and the /api/* backend.
  "name": "backlink-health-checker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // Unknown paths fall back to index.html so client-side routes work.
    "not_found_handling": "single-page-application",
    // /api/* always goes to the Worker first, never to static files.
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "Backlink Health Checker",
  },

  // Database. Create it once with:
  //   npx wrangler d1 create backlink-health-checker-db
  // then paste the printed database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backlink-health-checker-db",
      "database_id": "3328d067-f9a5-4c5f-9f5b-21e849ca90de",
      "migrations_dir": "migrations",
    },
  ],

  // Bindings added in later phases (kept here so the plan is visible):
  //   Phase 5  -> "queues"        (SCAN_QUEUE)
  //   Phase 8  -> "r2_buckets"    (EXPORTS) if exports get large
  //   Phase 11 -> "triggers": { "crons": [...] }

  "env": {
    "staging": {
      "name": "backlink-health-checker-staging",
      // Staging has its own database so test data never touches production:
      //   npx wrangler d1 create backlink-health-checker-db-staging
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "backlink-health-checker-db-staging",
          "database_id": "7290b7e4-a840-480a-90e4-0cccc623f850",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "APP_ENV": "staging",
        "APP_NAME": "Backlink Health Checker (Staging)",
      },
    },
  },
}
