{
  "manifest_version": 3,
  "name": "LinkLedger SEO – Google index helper",
  "short_name": "LinkLedger helper",
  "version": "1.0.0",
  "description": "Checks whether your backlinks are on Google by searching Google from your own browser, then reports the results to LinkLedger SEO.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkLedger helper",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://consent.google.com/*",
    "https://*.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
