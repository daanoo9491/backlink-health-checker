{
  "name": "backlink-health-checker",
  "version": "0.13.2",
  "private": true,
  "type": "module",
  "description": "Upload a backlink workbook, check which backlink pages are still alive, export the results.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/zip-extension.mjs && vite build",
    "preview": "npm run build && vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging npm run build && wrangler deploy",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\"",
    "db:migrate": "node scripts/migrate.mjs",
    "import:d1": "node scripts/import-from-d1.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
